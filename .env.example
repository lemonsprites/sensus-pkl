# ============================================================================
# SENSUS ASET BMN — contoh environment
# Salin: cp .env.example .env  (file .env TIDAK di-commit)
# ============================================================================

NODE_ENV=development
# Platform (git push) biasanya menyediakan PORT. Backend listen di 0.0.0.0.
PORT=3000
# URL publik aplikasi (opsional). Di produksi: https://<domain>
APP_URL=""
# Origin yang diizinkan, dipisah koma. Dev: http://localhost:5173
CORS_ORIGIN="http://localhost:5173"

# --- Database (Postgres 16) ---
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/sensus_pkl?schema=public"
# Wajib untuk `prisma migrate dev` (dibuat otomatis oleh `prisma migrate dev` bila role punya CREATEDB).
SHADOW_DATABASE_URL="postgresql://user:password@127.0.0.1:5432/sensus_pkl_shadow?schema=public"

# --- Redis 7 (shared dengan aplikasi lain) ---
REDIS_URL="redis://127.0.0.1:6379"
# Prefix WAJIB via registry K.* → format final: {REDIS_KEY_VERSION}:{REDIS_PREFIX}:
# Contoh Patch C (`inv:v1:{prefix}`) direkonsiliasi menjadi `v1:inv:`.
REDIS_PREFIX="inv"
REDIS_KEY_VERSION="v1"

# --- Auth ---
# Minimal 32 karakter acak. Ganti di produksi.
JWT_SECRET="ubah-ini-minimal-32-karakter-acak-xxxxxxxx"
JWT_EXPIRES_IN="12h"
# Seeder SUPERADMIN (M2). Bila password kosong → digenerate acak dan dicetak sekali.
SEED_SUPERADMIN_EMAIL="superadmin@sekolah.sch.id"
SEED_SUPERADMIN_PASSWORD=""

# --- MinIO / S3 (shared, service account khusus aplikasi ini) ---
# Internal = dipakai backend (server-side). Publik = dipakai presigned URL browser.
# DI PRODUKSI: MINIO_PUBLIC_ENDPOINT=https://s3.domain
# JANGAN pakai storage.domain (itu panel admin MinIO).
MINIO_ENDPOINT="http://127.0.0.1:9000"
MINIO_PUBLIC_ENDPOINT="http://127.0.0.1:9000"
MINIO_REGION="us-east-1"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin123"
MINIO_BUCKET_FOTO="inventaris-foto"
MINIO_BUCKET_THUMB="inventaris-thumb"
MINIO_BUCKET_PRIVATE="private"
# Bucket staging import SIMAN (Patch C) — private, lifecycle 7 hari.
MINIO_BUCKET_STAGING="inventaris-staging"

# --- SIMAN ---
# Kode satker madrasah (validasi import §9). Kosong = validasi dilewati (dev).
SATKER_KODE="025040200308319000KD"
# Regex NUP SIMAN. Kosong = validasi format dilewati (dev).
NUP_REGEX="^[0-9]+$"
# Isi QR label berasal dari Kode Register SIMAN (kolom BX export, unik 32 hex).
# Opsi: kode_register (default) | nup | custom.
QR_CONTENT_FORMAT="kode_register"

# --- Logging ---
LOG_LEVEL="debug"

# --- Import SIMAN (Patch C) ---
IMPORT_MAX_ROWS="50000"
IMPORT_MAX_SIZE_MB="50"
# TTL staging Redis (detik). Default 2 jam.
IMPORT_TTL_SECONDS="7200"
