# Gateway VPS: meneruskan domain publik ke aplikasi di VM101.
# Pasang di VPS (bukan vm101), lalu reload Nginx.
server {
    listen 80;
    listen [::]:80;
    server_name sensus.matsanesacis.sch.id;

    # Upload import SIMAN maks 50 MB (IMPORT_MAX_SIZE_MB) + overhead multipart.
    client_max_body_size 60m;

    location / {
        proxy_pass http://192.168.100.252:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
