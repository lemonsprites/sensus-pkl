// ============================================================================
// SENSUS ASET BMN — Prisma schema (MasterAset + SensusGrup)
// MasterAset = snapshot SSOT dari Excel/SIMAN; tidak diubah oleh sensus.
// SensusGrup = baris input mahasiswa (ruang + kode barang + kondisi + jumlah).
// Sensus = satu baris per NUP hasil alokasi.
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MAHASISWA
  ADMIN
  SUPERADMIN
}

enum SyncStatus {
  SNAPSHOT_AWAL
  TERSINKRON
  HILANG_DI_SIMAN
}

enum SensusStatus {
  DRAFT
  ASSESSED
  DOCS_COMPLETE
  VALIDATED
  TIDAK_DITEMUKAN
}

enum Kondisi {
  BAIK
  RUSAK_RINGAN
  RUSAK_BERAT
}

enum StatusMatch {
  COCOK
  TIDAK_COCOK
  TEMUAN_BARU
}

enum JenisDokumen {
  FOTO
  DOKUMEN
}

model User {
  id           String   @id @default(uuid())
  nama         String
  email        String   @unique
  passwordHash String
  role         Role     @default(MAHASISWA)
  isActive     Boolean  @default(true)
  tokenVersion Int      @default(0)
  lastLoginAt  DateTime?
  /// Identitas PKL untuk monitoring & laporan.
  nim          String?  @unique
  programStudi String?
  instansi     String?
  noHp         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sensusDiinput      Sensus[]        @relation("SensusDiinput")
  sensusDiverifikasi Sensus[]        @relation("SensusDiverifikasi")
  editHistory        EditHistory[]
  dokumenUpload      SensusDokumen[] @relation("DokumenUpload")
  sensusGrupDibuat   SensusGrup[]    @relation("GrupDibuat")
  sensusGrupDiubah   SensusGrup[]    @relation("GrupDiperbarui")
  activityLogs       ActivityLog[]   @relation("ActivityActor")
  labelDicetak       Sensus[]        @relation("LabelPrinted")
  labelDitempel      Sensus[]        @relation("LabelApplied")

  @@index([role, isActive])
}

/// Snapshot master dari Excel/SIMAN. Sumber referensi untuk mapping NUP.
model MasterAset {
  id            String  @id @default(uuid())
  /// NUP SIMAN (urutan per kodeBarang).
  kodeSiman     String?
  /// Kode Register SIMAN (unik, isi QR).
  kodeRegister  String? @unique
  kodeBarang    String?
  nama          String
  kategori      String?

  /// Hierarki aset (tanah → bangunan).
  parentAset   MasterAset?  @relation("HierarkiAset", fields: [parentAsetId], references: [id])
  parentAsetId String?
  childAset    MasterAset[] @relation("HierarkiAset")

  /// Field SIMAN yang dinormalisasi (subset; semua kolom asli ada di dataMentah).
  kodeSatker     String?
  jumlahLama     Int       @default(1)
  merk           String?
  noSeri         String?
  tahun          Int?
  nilaiPerolehan Decimal?  @db.Decimal(14, 2)
  kondisiSiman   String?
  statusAset     String?
  syncStatus     SyncStatus @default(SNAPSHOT_AWAL)
  snapshotAt     DateTime?
  lastSyncAt     DateTime?
  catatan        String?
  /// SELURUH kolom Excel asli: [{ header, value, column }].
  dataMentah     Json?

  sensus    Sensus?
  ruangAnak Ruang[]   @relation("RuangBangunan")
  createdAt DateTime  @default(now())

  @@unique([kodeBarang, kodeSiman])
  @@index([kodeSiman])
  @@index([nama])
  @@index([parentAsetId])
}

model Ruang {
  id            String   @id @default(uuid())
  kode          String   @unique
  kodeRegister  String?  @unique
  nama          String
  tipeRuang     String?
  luas          Decimal? @db.Decimal(10, 2)
  pic           String?

  bangunanAset   MasterAset @relation("RuangBangunan", fields: [bangunanAsetId], references: [id])
  bangunanAsetId String
  lantai         Int
  urutan         Int        @default(0)

  sensus Sensus[]
  grup   SensusGrup[]
  createdAt DateTime @default(now())

  @@unique([bangunanAsetId, lantai, kode])
  @@index([bangunanAsetId, lantai])
}

/// Satu baris input mahasiswa: aset X dengan kondisi Y sebanyak N.
model SensusGrup {
  id              String       @id @default(uuid())
  ruangId         String
  ruang           Ruang        @relation(fields: [ruangId], references: [id], onDelete: Cascade)
  kodeBarang      String
  namaBarang      String
  kondisi         Kondisi
  jumlah          Int
  status          SensusStatus @default(ASSESSED)
  docsComplete    Boolean      @default(false)
  catatan         String?
  catatanOtomatis String?
  createdById     String
  createdBy       User         @relation("GrupDibuat", fields: [createdById], references: [id])
  updatedById     String?
  updatedBy       User?        @relation("GrupDiperbarui", fields: [updatedById], references: [id])

  sensus  Sensus[]
  dokumen SensusDokumen[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ruangId, kodeBarang])
  @@index([status])
}

/// Satu baris per NUP (aset fisik) hasil alokasi grup.
model Sensus {
  id           String     @id @default(uuid())
  masterAsetId String     @unique
  masterAset   MasterAset @relation(fields: [masterAsetId], references: [id])
  grupId       String?
  grup         SensusGrup? @relation(fields: [grupId], references: [id], onDelete: SetNull)
  ruangId      String?
  ruang        Ruang?     @relation(fields: [ruangId], references: [id])

  status       SensusStatus @default(DRAFT)
  jumlahFisik  Int?
  kondisi      Kondisi?
  statusMatch  StatusMatch?
  isTemuanBaru Boolean      @default(false)
  docsComplete Boolean      @default(false)
  docsNote     String?
  labelPrintedAt DateTime?
  labelPrintedById String?
  labelPrintedBy   User?   @relation("LabelPrinted", fields: [labelPrintedById], references: [id])
  labelAppliedAt DateTime?
  labelAppliedById String?
  labelAppliedBy   User?   @relation("LabelApplied", fields: [labelAppliedById], references: [id])
  catatan      String?

  diinputOlehId      String
  diinputOleh        User    @relation("SensusDiinput", fields: [diinputOlehId], references: [id])
  diverifikasiOlehId String?
  diverifikasiOleh   User?   @relation("SensusDiverifikasi", fields: [diverifikasiOlehId], references: [id])
  diverifikasiAt     DateTime?

  editHistory EditHistory[]
  dokumen     SensusDokumen[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([statusMatch])
  @@index([ruangId])
  @@index([grupId])
}

model EditHistory {
  id        String   @id @default(uuid())
  sensusId  String
  sensus    Sensus   @relation(fields: [sensusId], references: [id], onDelete: Cascade)
  olehId    String
  oleh      User     @relation(fields: [olehId], references: [id])
  field     String
  nilaiLama String?
  nilaiBaru String?
  createdAt DateTime @default(now())

  @@index([sensusId, createdAt])
}

model ImportBatch {
  id          String    @id @default(uuid())
  filename    String
  fileSize    Int
  snapshotAt  DateTime
  totalRows   Int
  inserted    Int       @default(0)
  updated     Int       @default(0)
  skipped     Int       @default(0)
  errors      Json?
  /// Daftar header asli Excel (untuk audit tidak ada kolom hilang).
  headers     Json?
  status      String    @default("PREVIEW")
  importedBy  String
  committedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
}

model SensusDokumen {
  id           String       @id @default(uuid())
  sensusId     String?
  sensus       Sensus?      @relation(fields: [sensusId], references: [id], onDelete: Cascade)
  grupId       String?
  grup         SensusGrup?  @relation(fields: [grupId], references: [id], onDelete: Cascade)
  jenis        JenisDokumen @default(FOTO)
  bucket       String
  objectKey    String       @unique
  thumbKey     String?
  contentType  String?
  size         Int?
  uploadedById String
  uploadedBy   User         @relation("DokumenUpload", fields: [uploadedById], references: [id])
  createdAt    DateTime     @default(now())

  @@index([sensusId, jenis])
  @@index([grupId, jenis])
}

/// Log aktivitas global (kolaborasi & monitoring).
model ActivityLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// Snapshot nama agar log tetap terbaca walau user dinonaktifkan/dihapus.
  actorNama  String
  action     String
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}
