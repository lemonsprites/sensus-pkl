# Salin menjadi scripts/deploy-vm101.env (file ini di-gitignore).
# Semua nilai dapat dioverride dari environment saat menjalankan script.

SSH_HOST=vm101

# Direktori aplikasi di VM (sudah disiapkan di server).
REMOTE_DIR=/var/www/sensus-pkl

# Nama proses PM2 (harus unik di VM).
PM2_NAME=sensus-pkl

# Harus sama dengan PORT di .env remote (saat ini 3100) dan proxy_pass Nginx.
APP_PORT=3100

# File env remote; sebaiknya berada di dalam REMOTE_DIR agar dotenv menemukannya.
REMOTE_ENV_FILE=/var/www/sensus-pkl/.env

# Domain untuk ditampilkan di akhir deploy / contoh Nginx.
DOMAIN=sensus.matsanesacis.sch.id

# Gateway publik (VPS) dan alamat VM dari VPS.
GATEWAY_HOST=vps
UPSTREAM_HOST=192.168.100.252

# Opsi default (bisa dioverride dengan flag CLI):
# CONFIRM=1
# DRY_RUN=0
# ALLOW_DIRTY=0
# SYNC_ENV=0
