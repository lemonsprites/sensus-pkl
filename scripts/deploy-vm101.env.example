# Salin menjadi scripts/deploy-vm101.env (file ini di-gitignore).
# Semua nilai dapat dioverride dari environment saat menjalankan script.

SSH_HOST=vm101

# Direktori aplikasi di VM. /home/matsa aman tanpa sudo.
# Jika memakai /var/www/sensus-pkl, siapkan sekali:
#   ssh vm101 'sudo mkdir -p /var/www/sensus-pkl && sudo chown matsa:matsa /var/www/sensus-pkl'
REMOTE_DIR=/home/matsa/sensus-pkl

# Nama proses PM2 (harus unik di VM).
PM2_NAME=sensus-pkl

# Harus sama dengan PORT di .env remote dan proxy_pass Nginx.
APP_PORT=3000

# File env remote; sebaiknya berada di dalam REMOTE_DIR agar dotenv menemukannya.
REMOTE_ENV_FILE=/home/matsa/sensus-pkl/.env

# Domain untuk ditampilkan di akhir deploy / contoh Nginx.
DOMAIN=sensus.matsanesacis.sch.id

# Opsi default (bisa dioverride dengan flag CLI):
# CONFIRM=1
# DRY_RUN=0
# ALLOW_DIRTY=0
# SYNC_ENV=0
